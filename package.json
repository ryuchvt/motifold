{
  "name": "motifold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "server": "vite build && wrangler dev --var MODE:dev --ip 127.0.0.1 --port 8788",
    "build": "npm run types --silent && tsc -p . && vite build",
    "test": "vitest run",
    "types": "wrangler types server/worker-configuration.d.ts --include-env=false",
    "typecheck": "npm run types --silent && tsc -p . && tsc -p server",
    "dev:ui": "vite --mode ui --host 127.0.0.1 --port 5199 --strictPort"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "lucide-react": "^1.67.0",
    "opensheetmusicdisplay": "^2.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.148.0"
  }
}
